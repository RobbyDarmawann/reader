<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ComicReader.ViewModels"
    xmlns:views="using:ComicReader.Views"
    x:Class="ComicReader.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="ComicReader"
    Width="1280"
    Height="800"
    MinWidth="1000"
    MinHeight="650">

    <Window.DataTemplates>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BrowseViewModel}">
            <views:BrowseView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>

    </Window.DataTemplates>


    <Window.Styles>

        <!-- Navigation button -->
        <Style Selector="Button.nav-button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="#2A2A2A" />
        </Style>

        <!-- Small top bar button -->
        <Style Selector="Button.top-button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="18" />
        </Style>

    </Window.Styles>


    <Grid RowDefinitions="64,*">

        <!-- TOP BAR -->

        <Border
            Grid.Row="0"
            BorderBrush="#303030"
            BorderThickness="0,0,0,1"
            Padding="20,0">

            <Grid ColumnDefinitions="*,Auto,Auto">

                <TextBlock
                    Text="ComicReader"
                    FontSize="20"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Content="⌕"
                    Classes="top-button"
                    Margin="0,0,8,0" />

                <Button
                    Grid.Column="2"
                    Content="⚙"
                    Classes="top-button" />

            </Grid>

        </Border>


        <!-- BODY -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="240,*">

            <!-- SIDEBAR -->

            <Border
                Grid.Column="0"
                BorderBrush="#303030"
                BorderThickness="0,0,1,0"
                Padding="14">

                <Grid RowDefinitions="*,Auto">

                    <StackPanel>

                        <TextBlock
                            Text="LIBRARY"
                            FontSize="11"
                            FontWeight="Bold"
                            Opacity="0.55"
                            Margin="10,12,10,10" />

                        <Button
                            Content="⌂   Home"
                            Classes="nav-button"
                            Command="{Binding NavigateHomeCommand}" />

                        <Button
                            Content="▣   Library"
                            Classes="nav-button"
                            Command="{Binding NavigateLibraryCommand}" />

                        <Button
                            Content="⌕   Browse"
                            Classes="nav-button"
                            Command="{Binding NavigateBrowseCommand}" />

                        <TextBlock
                            Text="MANAGE"
                            FontSize="11"
                            FontWeight="Bold"
                            Opacity="0.55"
                            Margin="10,28,10,10" />

                        <Button
                            Content="↓   Downloads"
                            Classes="nav-button"
                            Command="{Binding NavigateDownloadsCommand}" />

                        <Button
                            Content="◷   History"
                            Classes="nav-button"
                            Command="{Binding NavigateHistoryCommand}" />

                    </StackPanel>


                    <TextBlock
                        Grid.Row="1"
                        Text="ComicReader v0.1"
                        FontSize="11"
                        Opacity="0.45"
                        Margin="10,10" />

                </Grid>

            </Border>


            <!-- CONTENT -->

            <Border
                Grid.Column="1"
                Padding="0">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <ContentControl
                        Content="{Binding CurrentViewModel}" />

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Window>