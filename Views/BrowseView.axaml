<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ComicReader.Views.BrowseView">

    <Grid>

        <Grid.Styles>
            <Style Selector="Border.browse-surface">
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style Selector="Button.section-button">
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="96" />
            </Style>

            <Style Selector="Button.section-button:pointerover">
                <Setter Property="Background" Value="#D97745" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style Selector="Border.manga-card">
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style Selector="TextBlock.eyebrow">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Opacity" Value="0.6" />
            </Style>
        </Grid.Styles>

        <!-- ================================================= -->
        <!-- NORMAL BROWSE CONTENT                             -->
        <!-- ================================================= -->

        <ScrollViewer
            x:Name="MainScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="34,30,34,48">

                <!-- EXTENSION PAGE -->

                <StackPanel x:Name="ExtensionPage">

                    <TextBlock
                        Text="Browse"
                        FontSize="34"
                        FontWeight="Bold" />

                    <TextBlock
                        Text="Pilih extension atau source untuk melihat katalog."
                        FontSize="16"
                        Opacity="0.65"
                        Margin="0,8,0,28"
                        MaxWidth="680"
                        TextWrapping="Wrap" />

                    <Border
                        Classes="browse-surface"
                        CornerRadius="10"
                        Padding="22"
                        MaxWidth="980">

                        <StackPanel>

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel>

                                    <TextBlock
                                        Text="Installed Sources"
                                        FontSize="22"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        x:Name="InstalledStatus"
                                        Text="Memeriksa source..."
                                        Margin="0,6,0,0"
                                        Opacity="0.65"/>

                                </StackPanel>

                                <Button
                                    x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Content="Refresh"
                                    Width="100"
                                    Height="40"/>

                            </Grid>

                            <StackPanel
                                x:Name="InstalledContainer"
                                Margin="0,20,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border
                        Classes="browse-surface"
                        CornerRadius="10"
                        Padding="22"
                        Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Extensions"
                                FontSize="22"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ExtensionStatus"
                                Text="Memuat daftar extension..."
                                Margin="0,6,0,0"
                                Opacity="0.65"/>

                            <Grid ColumnDefinitions="*,220" ColumnSpacing="10" Margin="0,16,0,0">
                                <TextBox
                                    x:Name="ExtensionSearchBox"
                                    PlaceholderText="Cari nama extension atau source..."
                                    Height="40"
                                    VerticalContentAlignment="Center" />
                                <ComboBox
                                    x:Name="ExtensionLanguageComboBox"
                                    Grid.Column="1"
                                    PlaceholderText="Semua negara / bahasa"
                                    Height="40" />
                            </Grid>

                            <StackPanel
                                x:Name="ExtensionContainer"
                                Margin="0,20,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- SOURCE PAGE -->

                <StackPanel
                    x:Name="SourcePage"
                    IsVisible="False">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="15">

                        <Button
                            x:Name="BackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                x:Name="SourceTitle"
                                Text="Source"
                                FontSize="28"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="SourceDescription"
                                Text=""
                                Opacity="0.65"/>

                        </StackPanel>

                    </Grid>


                    <!-- SEARCH -->

                    <Border
                        Classes="browse-surface"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <Grid ColumnDefinitions="*,Auto">

                                <TextBox
                                x:Name="SearchBox"
                                    Height="44"
                                    VerticalContentAlignment="Center"
                                    FontSize="15"
                                    PlaceholderText="Cari judul manga, manhwa, atau manhua..."/>

                                <Button
                                x:Name="SearchButton"
                                Grid.Column="1"
                                    Content="Cari"
                                    MinWidth="96"
                                    Height="44"
                                Margin="10,0,0,0"/>

                        </Grid>

                    </Border>


                    <!-- SECTION -->

                    <Border
                        Classes="browse-surface"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Explore catalog"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <StackPanel
                                x:Name="SectionContainer"
                                Margin="0,14,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- FILTERS -->

                    <Border
                        x:Name="FilterBorder"
                        Classes="browse-surface"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Refine results"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="Gabungkan genre, status, format, dan urutan untuk menemukan bacaan yang pas."
                                Margin="0,5,0,0"
                                Opacity="0.6"
                                TextWrapping="Wrap" />

                            <Grid
                                ColumnDefinitions="*,*,*"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="10"
                                Margin="0,16,0,0">

                                <ComboBox
                                    x:Name="GenreComboBox"
                                    Height="40"
                                    PlaceholderText="Genre"/>

                                <ComboBox
                                    x:Name="TypeComboBox"
                                    Grid.Column="1"
                                    Height="40"
                                    PlaceholderText="Type"/>

                                <ComboBox
                                    x:Name="StatusComboBox"
                                    Grid.Column="2"
                                    Height="40"
                                    PlaceholderText="Status"/>

                                <ComboBox
                                    x:Name="FormatComboBox"
                                    Grid.Row="1"
                                    Height="40"
                                    PlaceholderText="Format"/>

                                <ComboBox
                                    x:Name="SortComboBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Height="40"
                                    PlaceholderText="Sort"/>

                                <Button
                                    x:Name="ApplyFilterButton"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Content="Terapkan filter"
                                    Height="40"/>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <TextBlock
                        x:Name="CatalogStatus"
                        Text="Siap."
                        Margin="2,22,0,12"
                        FontSize="14"
                        Opacity="0.7"/>

                    <ItemsControl
                        x:Name="MangaGrid"
                        HorizontalAlignment="Stretch">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    Columns="4"
                                    HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                    </ItemsControl>

                </StackPanel>


                <!-- MANGA DETAIL PAGE -->

                <StackPanel
                    x:Name="MangaDetailPage"
                    IsVisible="False">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="20">

                        <Button
                            x:Name="DetailBackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                x:Name="DetailTitle"
                                Text="Manga"
                                FontSize="28"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="DetailSource"
                                Text=""
                                Opacity="0.65"/>

                        </StackPanel>

                    </Grid>


                    <Border
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <Grid
                            ColumnDefinitions="220,*"
                            ColumnSpacing="25">

                            <Image
                                x:Name="DetailCover"
                                Width="220"
                                Stretch="Uniform"
                                HorizontalAlignment="Left"/>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="8">

                                <TextBlock
                                    x:Name="DetailAuthor"
                                    Text="Author: -"/>

                                <TextBlock
                                    x:Name="DetailArtist"
                                    Text="Artist: -"/>

                                <TextBlock
                                    x:Name="DetailStatus"
                                    Text="Status: -"/>

                                <TextBlock
                                    x:Name="DetailType"
                                    Text="Type: -"/>

                                <TextBlock
                                    x:Name="DetailGenres"
                                    Text="Genres: -"/>

                                <TextBlock
                                    x:Name="DetailDescription"
                                    Text=""
                                    TextWrapping="Wrap"
                                    Margin="0,10,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <Border
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Chapters"
                                FontSize="22"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ChapterStatus"
                                Text="Memuat chapter..."
                                Margin="0,5,0,0"
                                Opacity="0.65"/>

                                    <Button
            x:Name="ResumeReadingButton"
            Content="▶ Lanjut Baca"
            HorizontalAlignment="Right"
            Margin="0,10,0,10"
            Padding="18,10"
            FontSize="14"
            FontWeight="SemiBold"
            IsVisible="False"/>
<StackPanel
                                x:Name="ChapterContainer"
                                Margin="0,18,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- ================================================= -->
        <!-- READER OVERLAY                                    -->
        <!-- ================================================= -->

        <Grid
            x:Name="ReaderPage"
            IsVisible="False"
            Background="#080808"
            Panel.ZIndex="1000">

            <Grid
                RowDefinitions="72,*">

                <!-- FIXED HEADER -->

                <Border
                    Grid.Row="0"
                    Background="#151515"
                    BorderBrush="#303030"
                    BorderThickness="0,0,0,1"
                    Padding="16">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="ReaderBackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1"
                            Margin="18,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="ReaderTitle"
                                Text="Reader"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ReaderChapter"
                                Text=""
                                FontSize="13"
                                Opacity="0.65"/>

                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Background="#252525"
                            CornerRadius="8"
                            Padding="14,7">

                            <TextBlock
                                x:Name="ReaderProgress"
                                Text="0%"
                                FontSize="15"
                                FontWeight="Bold"
                                MinWidth="55"
                                TextAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ONLY PAGES SCROLL -->

                <ScrollViewer
                    x:Name="ReaderScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        x:Name="ReaderPageContainer"
                        HorizontalAlignment="Center"
                        Spacing="2"/>

                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- Compatibility controls used by BrowseView.axaml.cs -->
        <StackPanel
            x:Name="ReaderNavigationCompatibility"
            IsVisible="False">

            <Button
                x:Name="ReaderTopButton"
                Content="Top"/>

            <Button
                x:Name="ReaderBottomButton"
                Content="Bottom"/>

        </StackPanel>

    </Grid>

</UserControl>






