<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ComicReader.Views.BrowseView">

    <Grid>

        <!-- ================================================= -->
        <!-- NORMAL BROWSE CONTENT                             -->
        <!-- ================================================= -->

        <ScrollViewer
            x:Name="MainScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="32">

                <!-- EXTENSION PAGE -->

                <StackPanel x:Name="ExtensionPage">

                    <TextBlock
                        Text="Browse"
                        FontSize="32"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Pilih extension atau source untuk melihat katalog."
                        FontSize="16"
                        Opacity="0.65"
                        Margin="0,8,0,25"/>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20">

                        <StackPanel>

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel>

                                    <TextBlock
                                        Text="Installed Sources"
                                        FontSize="22"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        x:Name="InstalledStatus"
                                        Text="Memeriksa source..."
                                        Margin="0,6,0,0"
                                        Opacity="0.65"/>

                                </StackPanel>

                                <Button
                                    x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Content="Refresh"
                                    Width="100"
                                    Height="40"/>

                            </Grid>

                            <StackPanel
                                x:Name="InstalledContainer"
                                Margin="0,20,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Extensions"
                                FontSize="22"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ExtensionStatus"
                                Text="Memuat daftar extension..."
                                Margin="0,6,0,0"
                                Opacity="0.65"/>

                            <StackPanel
                                x:Name="ExtensionContainer"
                                Margin="0,20,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- SOURCE PAGE -->

                <StackPanel
                    x:Name="SourcePage"
                    IsVisible="False">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="15">

                        <Button
                            x:Name="BackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                x:Name="SourceTitle"
                                Text="Source"
                                FontSize="28"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="SourceDescription"
                                Text=""
                                Opacity="0.65"/>

                        </StackPanel>

                    </Grid>


                    <!-- SEARCH -->

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,20,0,0">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBox
                                x:Name="SearchBox"
                                PlaceholderText="Cari manga..."/>

                            <Button
                                x:Name="SearchButton"
                                Grid.Column="1"
                                Content="Search"
                                Width="100"
                                Margin="10,0,0,0"/>

                        </Grid>

                    </Border>


                    <!-- SECTION -->

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Section"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <StackPanel
                                x:Name="SectionContainer"
                                Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- FILTERS -->

                    <Border
                        x:Name="FilterBorder"
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,15,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Filters"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <Grid
                                ColumnDefinitions="*,*,*"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="10"
                                Margin="0,12,0,0">

                                <ComboBox
                                    x:Name="GenreComboBox"
                                    PlaceholderText="Genre"/>

                                <ComboBox
                                    x:Name="TypeComboBox"
                                    Grid.Column="1"
                                    PlaceholderText="Type"/>

                                <ComboBox
                                    x:Name="StatusComboBox"
                                    Grid.Column="2"
                                    PlaceholderText="Status"/>

                                <ComboBox
                                    x:Name="FormatComboBox"
                                    Grid.Row="1"
                                    PlaceholderText="Format"/>

                                <ComboBox
                                    x:Name="SortComboBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    PlaceholderText="Sort"/>

                                <Button
                                    x:Name="ApplyFilterButton"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Content="Apply"/>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <TextBlock
                        x:Name="CatalogStatus"
                        Text="Siap."
                        Margin="0,18,0,10"/>

                    <ItemsControl
                        x:Name="MangaGrid"/>

                </StackPanel>


                <!-- MANGA DETAIL PAGE -->

                <StackPanel
                    x:Name="MangaDetailPage"
                    IsVisible="False">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="20">

                        <Button
                            x:Name="DetailBackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                x:Name="DetailTitle"
                                Text="Manga"
                                FontSize="28"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="DetailSource"
                                Text=""
                                Opacity="0.65"/>

                        </StackPanel>

                    </Grid>


                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <Grid
                            ColumnDefinitions="220,*"
                            ColumnSpacing="25">

                            <Image
                                x:Name="DetailCover"
                                Width="220"
                                Stretch="Uniform"
                                HorizontalAlignment="Left"/>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="8">

                                <TextBlock
                                    x:Name="DetailAuthor"
                                    Text="Author: -"/>

                                <TextBlock
                                    x:Name="DetailArtist"
                                    Text="Artist: -"/>

                                <TextBlock
                                    x:Name="DetailStatus"
                                    Text="Status: -"/>

                                <TextBlock
                                    x:Name="DetailType"
                                    Text="Type: -"/>

                                <TextBlock
                                    x:Name="DetailGenres"
                                    Text="Genres: -"/>

                                <TextBlock
                                    x:Name="DetailDescription"
                                    Text=""
                                    TextWrapping="Wrap"
                                    Margin="0,10,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Chapters"
                                FontSize="22"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ChapterStatus"
                                Text="Memuat chapter..."
                                Margin="0,5,0,0"
                                Opacity="0.65"/>

                            <StackPanel
                                x:Name="ChapterContainer"
                                Margin="0,18,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- ================================================= -->
        <!-- READER OVERLAY                                    -->
        <!-- ================================================= -->

        <Grid
            x:Name="ReaderPage"
            IsVisible="False"
            Background="#080808"
            Panel.ZIndex="1000">

            <Grid
                RowDefinitions="72,*">

                <!-- FIXED HEADER -->

                <Border
                    Grid.Row="0"
                    Background="#151515"
                    BorderBrush="#303030"
                    BorderThickness="0,0,0,1"
                    Padding="16">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        VerticalAlignment="Center">

                        <Button
                            x:Name="ReaderBackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1"
                            Margin="18,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="ReaderTitle"
                                Text="Reader"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ReaderChapter"
                                Text=""
                                FontSize="13"
                                Opacity="0.65"/>

                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Background="#252525"
                            CornerRadius="8"
                            Padding="14,7">

                            <TextBlock
                                x:Name="ReaderProgress"
                                Text="0%"
                                FontSize="15"
                                FontWeight="Bold"
                                MinWidth="55"
                                TextAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ONLY PAGES SCROLL -->

                <ScrollViewer
                    x:Name="ReaderScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        x:Name="ReaderPageContainer"
                        HorizontalAlignment="Center"
                        Spacing="2"/>

                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- Compatibility controls used by BrowseView.axaml.cs -->
        <StackPanel
            x:Name="ReaderNavigationCompatibility"
            IsVisible="False">

            <Button
                x:Name="ReaderTopButton"
                Content="Top"/>

            <Button
                x:Name="ReaderBottomButton"
                Content="Bottom"/>

        </StackPanel>

    </Grid>

</UserControl>


