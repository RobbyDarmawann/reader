<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ComicReader.ViewModels"
    x:Class="ComicReader.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" MaxWidth="860">
            <TextBlock Text="Settings" FontSize="34" FontWeight="Bold" />
            <TextBlock Text="Sesuaikan pengalaman membaca untuk satu perangkat ini."
                       FontSize="16" Opacity="0.65" Margin="0,8,0,28" />
            <Border Padding="24" Background="#1E1E1E" CornerRadius="12" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Theme" Opacity="0.65" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
            </Border>
            <Border Padding="24" Background="#1E1E1E" CornerRadius="12" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Reading" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Reading mode" Opacity="0.65" />
                    <ComboBox ItemsSource="{Binding ReadingModes}" SelectedItem="{Binding SelectedReadingMode}" />
                    <TextBlock Text="Vertical cocok untuk webtoon. Horizontal akan tersedia saat sumber mendukungnya."
                               FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="24" Background="#1E1E1E" CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Downloads" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Folder penyimpanan chapter" Opacity="0.65" />
                    <TextBox Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Default: folder ComicReader di LocalAppData" />
                    <Button Content="Save download location" HorizontalAlignment="Left"
                            Click="SaveDownloadFolder_Click" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>