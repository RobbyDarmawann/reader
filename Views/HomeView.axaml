<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reading="using:ComicReader.Infrastructure.Reading"
    xmlns:vm="using:ComicReader.ViewModels"
    x:Class="ComicReader.Views.HomeView"
    x:DataType="vm:HomeViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="40">

            <StackPanel.Styles>
                <Style Selector="Button.link-button">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </StackPanel.Styles>

            <TextBlock
                Text="Welcome back"
                FontSize="32"
                FontWeight="Bold" />

            <TextBlock
                Text="Continue reading your favorite comics."
                FontSize="16"
                Opacity="0.65"
                Margin="0,8,0,35" />

            <TextBlock
                Text="Continue Reading"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,18" />

            <ItemsControl
                ItemsSource="{Binding ContinueReading}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate
                        x:DataType="vm:HomeReadingItem">

                        <Border
                            Padding="18"
                            Margin="0,0,0,12"
                            CornerRadius="12"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            MaxWidth="860">

                            <Grid
                                ColumnDefinitions="112,*">

                                <Button Width="100" Height="140"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OpenDetailButton_Click">
                                    <Border Background="{DynamicResource SystemControlBackgroundLowBrush}" CornerRadius="8">
                                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                    </Border>
                                </Button>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">

                                    <Button
                                        Content="{Binding MangaTitle}"
                                        Classes="link-button"
                                        HorizontalContentAlignment="Left"
                                        Click="OpenDetailButton_Click" />

                                    <TextBlock
                                        Text="{Binding ChapterName}"
                                        Margin="0,8,0,4"
                                        Opacity="0.75" />

                                    <TextBlock
                                        Text="{Binding UpdatedAt}"
                                        FontSize="12"
                                        Opacity="0.5"
                                        Margin="0,0,0,15" />

                                    <Button
                                        Content="▶ Lanjut Baca" Click="ResumeButton_Click"
                                        HorizontalAlignment="Left" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <Border
                IsVisible="{Binding HasContinueReading}"
                Padding="20"
                Margin="0,10,0,0"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="12"
                MaxWidth="800">

                <TextBlock
                    Text="History tersimpan secara lokal."
                    Opacity="0.55" />

            </Border>

            <TextBlock
                Text="Latest Updates"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,40,0,18" />

            <Border Padding="24" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="10" MaxWidth="800">
                <StackPanel>
                    <TextBlock Text="Latest updates" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Update terbaru dari source yang dipakai akan muncul di sini. Jelajahi katalog untuk mulai membaca."
                               Margin="0,8,0,0" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>

