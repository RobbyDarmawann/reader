<!-- READER -->

        <Grid
    x:Name="ReaderPage"
    IsVisible="False"
    Background="#080808">

    <ScrollViewer
        x:Name="ReaderScrollViewer"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            x:Name="ReaderPageContainer"
            HorizontalAlignment="Center"
            Spacing="2"/>

    </ScrollViewer>

    <!-- Floating reader header -->
    <Border
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        Margin="14"
        Padding="12,9"
        Background="#CC111111"
        CornerRadius="10"
        ZIndex="100">

        <Grid
            ColumnDefinitions="Auto,*,Auto"
            VerticalAlignment="Center">

            <Button
                x:Name="ReaderBackButton"
                Content="← Back"
                Width="88"
                Height="36"/>

            <StackPanel
                Grid.Column="1"
                Margin="14,0"
                VerticalAlignment="Center">

                <TextBlock
                    x:Name="ReaderTitle"
                    Text="Reader"
                    FontSize="17"
                    FontWeight="Bold"/>

                <TextBlock
                    x:Name="ReaderChapter"
                    Text=""
                    FontSize="12"
                    Opacity="0.72"/>

            </StackPanel>

            <TextBlock
                x:Name="ReaderProgress"
                Grid.Column="2"
                Text="Chapter 0/0 • Page 0/0 • 0%"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"/>

        </Grid>
    </Border>

    <!-- Reader mode indicator -->
    <Border
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="14"
        Padding="9,5"
        Background="#AA111111"
        CornerRadius="7"
        ZIndex="100">

        <TextBlock
            Text="Vertical / Webtoon"
            FontSize="11"
            Opacity="0.65"/>

    </Border>

    <!-- Compatibility buttons kept for code-behind -->
    <StackPanel
        x:Name="ReaderNavigationCompatibility"
        IsVisible="False">

        <Button
            x:Name="ReaderTopButton"
            Content="Top"/>

        <Button
            x:Name="ReaderBottomButton"
            Content="Bottom"/>

    </StackPanel>

</Grid>

    </Grid>

</UserControl>


