<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ComicReader.Views.BrowseView">

    <Grid>

        <!-- EXTENSIONS / SOURCE / DETAIL -->

        <ScrollViewer
            x:Name="MainScrollViewer">

            <StackPanel Margin="32">

                <!-- EXTENSION PAGE -->

                <StackPanel x:Name="ExtensionPage">

                    <TextBlock
                        Text="Browse"
                        FontSize="32"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Pilih extension atau source untuk melihat katalog."
                        FontSize="16"
                        Opacity="0.65"
                        Margin="0,8,0,25"/>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20">

                        <StackPanel>

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel>

                                    <TextBlock
                                        Text="Installed Sources"
                                        FontSize="22"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        x:Name="InstalledStatus"
                                        Text="Memeriksa source..."
                                        Margin="0,6,0,0"
                                        Opacity="0.65"/>

                                </StackPanel>

                                <Button
                                    x:Name="RefreshButton"
                                    Grid.Column="1"
                                    Content="Refresh"
                                    Width="100"
                                    Height="40"/>

                            </Grid>

                            <StackPanel
                                x:Name="InstalledContainer"
                                Margin="0,20,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">

                        <StackPanel>

                            <TextBlock
                                Text="Extensions"
                                FontSize="22"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ExtensionStatus"
                                Text="Memuat daftar extension..."
                                Margin="0,6,0,0"
                                Opacity="0.65"/>

                            <StackPanel
                                x:Name="ExtensionContainer"
                                Margin="0,20,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- SOURCE PAGE -->

                <StackPanel
                    x:Name="SourcePage"
                    IsVisible="False">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="15">

                        <Button
                            x:Name="BackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel Grid.Column="1">

                            <TextBlock
                                x:Name="SourceTitle"
                                Text="Source"
                                FontSize="30"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="SourceDescription"
                                Text=""
                                Margin="0,5,0,0"
                                Opacity="0.65"/>

                        </StackPanel>

                    </Grid>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,22,0,15">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <TextBox
                                x:Name="SearchBox"
                                Height="42"
                                PlaceholderText="Search manga..."/>

                            <Button
                                x:Name="SearchButton"
                                Grid.Column="1"
                                Content="Search"
                                Width="100"
                                Height="42"/>

                        </Grid>

                    </Border>

                    <StackPanel
                        x:Name="SectionContainer"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,18"/>

                    <Border
                        x:Name="FilterBorder"
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,20">

                        <StackPanel>

                            <Grid
                                ColumnDefinitions="*,*,*,*,Auto"
                                ColumnSpacing="10">

                                <ComboBox
                                    x:Name="GenreComboBox"
                                    Grid.Column="0"/>

                                <ComboBox
                                    x:Name="TypeComboBox"
                                    Grid.Column="1"/>

                                <ComboBox
                                    x:Name="StatusComboBox"
                                    Grid.Column="2"/>

                                <ComboBox
                                    x:Name="FormatComboBox"
                                    Grid.Column="3"/>

                                <Button
                                    x:Name="ApplyFilterButton"
                                    Grid.Column="4"
                                    Content="Apply"
                                    Width="90"/>

                            </Grid>

                            <ComboBox
                                x:Name="SortComboBox"
                                Width="180"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        x:Name="CatalogStatus"
                        Text="Memuat katalog..."
                        Margin="0,0,0,15"
                        Opacity="0.65"/>

                    <ItemsControl x:Name="MangaGrid">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <WrapPanel
                                    Orientation="Horizontal"
                                    ItemWidth="175"
                                    ItemHeight="315"/>

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                    </ItemsControl>

                </StackPanel>


                <!-- DETAIL PAGE -->

                <StackPanel
                    x:Name="MangaDetailPage"
                    IsVisible="False">

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="15">

                        <Button
                            x:Name="DetailBackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel Grid.Column="1">

                            <TextBlock
                                x:Name="DetailTitle"
                                Text="Manga"
                                FontSize="30"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="DetailSource"
                                Text=""
                                Margin="0,5,0,0"
                                Opacity="0.65"/>

                        </StackPanel>

                    </Grid>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,22,0,20">

                        <Grid
                            ColumnDefinitions="190,*"
                            ColumnSpacing="25">

                            <Border
                                Width="180"
                                Height="260"
                                Background="#303030"
                                CornerRadius="8">

                                <Image
                                    x:Name="DetailCover"
                                    Stretch="UniformToFill"/>

                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="8">

                                <TextBlock
                                    x:Name="DetailAuthor"
                                    Text=""
                                    FontSize="14"/>

                                <TextBlock
                                    x:Name="DetailArtist"
                                    Text=""
                                    FontSize="14"/>

                                <TextBlock
                                    x:Name="DetailStatus"
                                    Text=""
                                    FontSize="14"/>

                                <TextBlock
                                    x:Name="DetailType"
                                    Text=""
                                    FontSize="14"/>

                                <TextBlock
                                    x:Name="DetailGenres"
                                    Text=""
                                    TextWrapping="Wrap"
                                    FontSize="14"/>

                                <TextBlock
                                    Text="Synopsis"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Margin="0,15,0,0"/>

                                <TextBlock
                                    x:Name="DetailDescription"
                                    Text="Memuat synopsis..."
                                    TextWrapping="Wrap"
                                    MaxWidth="850"
                                    Opacity="0.8"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border
                        Background="#1E1E1E"
                        CornerRadius="10"
                        Padding="20">

                        <StackPanel>

                            <TextBlock
                                Text="Chapters"
                                FontSize="22"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ChapterStatus"
                                Text="Memuat chapter..."
                                Margin="0,5,0,0"
                                Opacity="0.65"/>

                            <StackPanel
                                x:Name="ChapterContainer"
                                Margin="0,18,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- READER OVERLAY -->

        <Grid
            x:Name="ReaderPage"
            IsVisible="False"
            Background="#080808"
            Panel.ZIndex="1000">

            <Grid RowDefinitions="72,*">

                <!-- FIXED READER HEADER -->

                <Border
                    Grid.Row="0"
                    Background="#151515"
                    BorderBrush="#303030"
                    BorderThickness="0,0,0,1"
                    Padding="16"
                    ZIndex="10">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          VerticalAlignment="Center">

                        <Button
                            x:Name="ReaderBackButton"
                            Content="← Back"
                            Width="90"
                            Height="40"/>

                        <StackPanel
                            Grid.Column="1"
                            Margin="18,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="ReaderTitle"
                                Text="Reader"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="ReaderChapter"
                                Text=""
                                FontSize="13"
                                Opacity="0.65"/>

                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Background="#252525"
                            CornerRadius="8"
                            Padding="14,7"
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="ReaderProgress"
                                Text="0%"
                                FontSize="15"
                                FontWeight="Bold"
                                MinWidth="55"
                                TextAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ONLY THIS SCROLLS -->

                <ScrollViewer
                    x:Name="ReaderScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        x:Name="ReaderPageContainer"
                        HorizontalAlignment="Center"
                        Spacing="2"/>

                </ScrollViewer>

            </Grid>

        </Grid>

            </Border>


            <!-- PAGES -->

            <ScrollViewer
                x:Name="ReaderScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Auto"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

                <StackPanel
                    x:Name="ReaderPageContainer"
                    HorizontalAlignment="Center"
                    Spacing="2"/>

            </ScrollViewer>


            <!-- READER FOOTER -->

            <Border
                Grid.Row="2"
                Background="#151515"
                Padding="10">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Button
                        x:Name="ReaderTopButton"
                        Content="↑ Top"
                        Width="80"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="Vertical / Webtoon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.6"/>

                    <Button
                        x:Name="ReaderBottomButton"
                        Grid.Column="2"
                        Content="↓ Bottom"
                        Width="80"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>


