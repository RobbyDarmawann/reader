<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ComicReader.Views.LibraryView">

    <StackPanel Margin="40">

        <TextBlock
            Text="Library"
            FontSize="32"
            FontWeight="Bold" />

        <TextBlock
            Text="Your manga collection"
            FontSize="16"
            Opacity="0.65"
            Margin="0,8,0,30" />

        <Border
            Height="300"
            Background="#1E1E1E"
            CornerRadius="12">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Your library is empty"
                    FontSize="22"
                    FontWeight="Bold"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Browse manga and add your favorites here."
                    Margin="0,8,0,20"
                    Opacity="0.6"
                    HorizontalAlignment="Center" />

                <Button
                    Content="Browse Manga"
                    HorizontalAlignment="Center" />

            </StackPanel>

        </Border>

    </StackPanel>

</UserControl>