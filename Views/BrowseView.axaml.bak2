<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ComicReader.Views.BrowseView"
    x:CompileBindings="False">

    <ScrollViewer>

        <StackPanel Margin="32">

            <TextBlock
                Text="Browse"
                FontSize="32"
                FontWeight="Bold"/>

            <TextBlock
                Text="Find manga from your installed sources and extensions."
                FontSize="16"
                Opacity="0.65"
                Margin="0,8,0,28"/>


            <!-- EXTENSIONS HEADER -->

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel>

                    <TextBlock
                        Text="Extensions"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding StatusText}"
                        FontSize="14"
                        Opacity="0.65"
                        Margin="0,5,0,0"/>

                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="Refresh"
                    Width="100"
                    Height="40"
                    Click="Refresh_Click"/>

            </Grid>


            <!-- LANGUAGE FILTER -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,20,0,16">

                <TextBlock
                    Text="Filter by language"
                    VerticalAlignment="Center"
                    Opacity="0.7"/>

                <ComboBox
                    x:Name="LanguageBox"
                    Grid.Column="1"
                    Width="180"
                    ItemsSource="{Binding Languages}"
                    SelectedIndex="0"
                    SelectionChanged="LanguageChanged"/>

            </Grid>


            <!-- EXTENSION LIST -->

            <ItemsControl
                x:Name="ExtensionList">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Background="#1E1E1E"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,12">

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel>

                                    <TextBlock
                                        x:Name="ExtensionName"
                                        FontSize="18"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        x:Name="ExtensionPackage"
                                        FontSize="12"
                                        Opacity="0.5"
                                        Margin="0,5,0,0"/>

                                    <TextBlock
                                        x:Name="ExtensionVersion"
                                        FontSize="13"
                                        Opacity="0.7"
                                        Margin="0,10,0,0"/>

                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Content="Install"
                                    Padding="22,0"
                                    VerticalAlignment="Center"
                                    Click="Install_Click"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</UserControl>
